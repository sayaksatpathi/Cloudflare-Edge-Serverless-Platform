{
  // EdgeForge - Cloudflare Edge & Serverless Platform
  // Primary Wrangler configuration
  "name": "edgeforge",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgeforge-db",
      "database_id": "YOUR_D1_DATABASE_ID_HERE"
    }
  ],

  // Workers KV binding
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "YOUR_KV_NAMESPACE_ID_HERE",
      "preview_id": "YOUR_KV_PREVIEW_ID_HERE"
    }
  ],

  // R2 bucket binding
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "edgeforge-assets"
    }
  ],

  // Queue binding (producer)
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "edgeforge-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "edgeforge-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "edgeforge-jobs-dlq"
      }
    ]
  },

  // Durable Objects
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },

  // Cron Triggers
  "triggers": {
    "crons": [
      "0 2 * * *",
      "*/30 * * * *"
    ]
  },

  // Observability
  "observability": {
    "enabled": true
  },

  // Environment variables (non-secret)
  "vars": {
    "APP_ENV": "development",
    "VERSION": "1.0.0",
    "MAX_UPLOAD_BYTES": "52428800",
    "RATE_LIMIT_REQUESTS": "60",
    "RATE_LIMIT_WINDOW_SECS": "60",
    "TOKEN_EXPIRY_SECS": "86400",
    "CACHE_TTL_SECS": "300"
  },

  // Development environment
  "env": {
    "staging": {
      "name": "edgeforge-staging",
      "vars": {
        "APP_ENV": "staging",
        "VERSION": "1.0.0",
        "MAX_UPLOAD_BYTES": "52428800",
        "RATE_LIMIT_REQUESTS": "30",
        "RATE_LIMIT_WINDOW_SECS": "60",
        "TOKEN_EXPIRY_SECS": "86400",
        "CACHE_TTL_SECS": "300"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "edgeforge-db-staging",
          "database_id": "YOUR_D1_STAGING_DATABASE_ID_HERE"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "YOUR_KV_STAGING_ID_HERE",
          "preview_id": "YOUR_KV_STAGING_PREVIEW_ID_HERE"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "edgeforge-assets-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOB_QUEUE",
            "queue": "edgeforge-jobs-staging"
          }
        ],
        "consumers": [
          {
            "queue": "edgeforge-jobs-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "edgeforge-jobs-staging-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiter"
          }
        ]
      },
      "triggers": {
        "crons": ["0 2 * * *", "*/30 * * * *"]
      }
    },

    "production": {
      "name": "edgeforge-production",
      "vars": {
        "APP_ENV": "production",
        "VERSION": "1.0.0",
        "MAX_UPLOAD_BYTES": "52428800",
        "RATE_LIMIT_REQUESTS": "60",
        "RATE_LIMIT_WINDOW_SECS": "60",
        "TOKEN_EXPIRY_SECS": "86400",
        "CACHE_TTL_SECS": "300"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "edgeforge-db-production",
          "database_id": "YOUR_D1_PRODUCTION_DATABASE_ID_HERE"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "YOUR_KV_PRODUCTION_ID_HERE",
          "preview_id": "YOUR_KV_PRODUCTION_PREVIEW_ID_HERE"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "edgeforge-assets-production"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOB_QUEUE",
            "queue": "edgeforge-jobs-production"
          }
        ],
        "consumers": [
          {
            "queue": "edgeforge-jobs-production",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "edgeforge-jobs-production-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiter"
          }
        ]
      },
      "triggers": {
        "crons": ["0 2 * * *", "*/30 * * * *"]
      }
    }
  },

  // Migration configuration
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["RateLimiter"]
    }
  ]
}
